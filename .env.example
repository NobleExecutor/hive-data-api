# Copier ce fichier en .env puis renseigner API_KEY.

# Écoute : 127.0.0.1 en production (seul Nginx est exposé).
PORT=3000
HOST=127.0.0.1

# Clé partagée avec l'application PHP (au moins 32 caractères).
# Générer avec : openssl rand -hex 32
API_KEY=

# Fuseau des créneaux 08:00 / 20:00. Ne pas changer.
TZ=Europe/Paris

# Pool de séries de référence (les vraies séries ne sont pas versionnées).
SERIES_PATH=data/series.sample.json

# Base SQLite (liste des ruches uniquement).
DB_PATH=data/api.db

# Nombre maximal de ruches enregistrées.
MAX_HIVES=200

# Jours d'historique disponibles à la création d'une ruche.
HISTORY_DAYS=30
